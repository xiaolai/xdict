# Private, never committed — the same choice XiaolaiDict made: design notes and the agent
# bridge stay on this machine. dev-docs/ is its own repository beside main/ (root AGENTS.md,
# 2026-10-20), not an entry here. Slash-free so a worktree's symlink back here matches too.
/AGENTS.md
/CLAUDE.md
/.claude
/.agents
/.codex
/.cc-suite
/.cc-suite.md
/.mcp.json

# Every other AI assistant's files stay private the same way: project plugins' state (english-buddy) and
# the instruction files and folders other coding agents create.
/.english-buddy.json
/.claude-english-buddy.json
/CLAUDE.local.md
/GEMINI.md
/.gemini
/.grok
/.opencode
/opencode.json
/QWEN.md
/.qwen
/.kimi
/.cursor
/.cursorrules
/.windsurf
/.windsurfrules
/.continue
/.aider*
/.github/copilot-instructions.md

# Build output: Rust's target directory wherever a workspace sits, Swift's .build, and Xcode's per-user
# state except the shared schemes.
target/
/.build
# The macOS shell's: SwiftPM's and cargo's build output, and the core as `Tools/build-core.sh` generates it (the static
# library as an XCFramework, and its UniFFI binding).
/apps/apple/.build
/apps/apple/Generated
/apps/apple/.swiftpm/*
!/apps/apple/.swiftpm/xcode
/apps/apple/.swiftpm/xcode/*
!/apps/apple/.swiftpm/xcode/xcshareddata
/.swiftpm/*
!/.swiftpm/xcode
/.swiftpm/xcode/*
!/.swiftpm/xcode/xcshareddata

# Dictionary files never enter this repository: they are licensed to the reader, not to XDict.
*.mdx
*.mdd

# Secrets, wherever they land.
.env
.env.*

# The machine-local build settings (E2E host and the like), wherever a checkout keeps one.
local.mk

# >>> cc-suite >>>
# cc-suite-schema: 8
# AI assistant local state
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/*.local.*
CLAUDE.local.md

# Codex CLI — local files, keep checked-in subdirs
.codex/*
!.codex/skills/
!.codex/prompts/
!.codex/hooks.json
!.codex/hooks.cc-suite.json
!.codex/config.toml

# cc-suite-managed symlinks (created by bridge_skills.sh) — derived, not authored
.claude/skills/cc-suite
.agents/skills

# Antigravity workspace MCP config is generated from .mcp.json and may contain
# credentials or machine-specific paths.
.agents/mcp_config.json
.agents/.cc-suite-mcp.provenance.json

# cc-suite tool-profile bridge (grok/opencode/qwen) — derived provenance
# sidecars tracking which MCP servers cc-suite owns. Not authored.
.cc-suite-*.provenance.json

# cc-suite local state — what init created, and the pre-bridge CLAUDE.md backup.
# Machine-local bookkeeping, not shared. Listed file-by-file on purpose:
# .cc-suite/agents/ holds declared advisors and IS meant to be committed.
.cc-suite/provenance
.cc-suite/original-claude.md
# Audit findings files written by /cc-suite:audit and the audit-fix loop —
# per-run working state (findings + fix statuses), not authored content.
.cc-suite/audits/
# <<< cc-suite <<<
__pycache__/
