<Project>
  <!-- Shared by every project under apps/windows. A warning is a failure: the build gate's red-once case. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- The Windows shell's version: Provenance.txt, the MSI and its file name all read it from here. -->
    <Version>0.1.3</Version>
  </PropertyGroup>
</Project>
