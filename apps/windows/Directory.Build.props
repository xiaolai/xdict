<Project>
  <!-- Shared by every project under apps/windows. A warning is a failure: the build gate's red-once case. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- The Windows shell's version: Provenance.txt, the MSI and its file name all read it from here. 0.3.0 is the
         sync release (contract 3); 0.2.0 was the learning release (contract 2, tagged from its own commit). -->
    <Version>0.3.0</Version>
  </PropertyGroup>
</Project>
