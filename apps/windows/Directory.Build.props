<Project>
  <!-- Shared by every project under apps/windows. A warning is a failure: the build gate's red-once case. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- The Windows shell's version: Provenance.txt, the MSI and its file name all read it from here. 0.4.0 is the
         Explore release (contract 5); 0.3.0 was the AI and sync release (contract 4). -->
    <Version>0.4.0</Version>
  </PropertyGroup>
</Project>
