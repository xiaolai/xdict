<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XDict.App.DictionariesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="12">
            <Button x:Name="AddFileButton" Click="AddFile" />
            <Button x:Name="AddFolderButton" Click="AddFolder" />
            <Button x:Name="UpButton" Click="MoveUp" />
            <Button x:Name="DownButton" Click="MoveDown" />
            <Button x:Name="ToggleButton" Click="Toggle" />
            <Button x:Name="RemoveButton" Click="Remove" />
            <Button x:Name="DetailsButton" Click="ShowDetails" />
            <Button x:Name="JoinButton" Click="Join" />
            <Button x:Name="SplitButton" Click="Split" />
            <Button x:Name="CancelButton" Click="Cancel" Visibility="Collapsed" />
        </StackPanel>
        <ListView x:Name="Dictionaries" Grid.Row="1" Margin="12,0" SelectionMode="Single"
                  AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" />
        <StackPanel Grid.Row="2" Spacing="{StaticResource XDictSpaceXs}"
                    Padding="{StaticResource XDictSpaceMThickness}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource XDictSpaceSm}">
                <TextBlock x:Name="WordPackLabel" VerticalAlignment="Center"
                           FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="WordPackInstall" Click="InstallWordPack"
                        AutomationProperties.AutomationId="SettingsWordPackInstall" />
                <Button x:Name="WordPackRemove" Click="RemoveWordPack"
                        AutomationProperties.AutomationId="SettingsWordPackRemove" />
                <Button x:Name="WordPackBuild" Click="BuildWordPack"
                        AutomationProperties.AutomationId="SettingsWordPackBuild" />
                <Button x:Name="WordPackCancel" Click="CancelWordPackBuild" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsWordPackCancel" />
            </StackPanel>
            <ProgressBar x:Name="WordPackBar" Maximum="100" Visibility="Collapsed"
                         AutomationProperties.AutomationId="SettingsWordPackProgress" />
            <TextBlock x:Name="WordPackStatus" TextWrapping="Wrap"
                       FontSize="{StaticResource XDictTextCardMeta}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="Status" Grid.Row="3" Margin="12,8" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="4" Margin="12,0,12,12" MaxHeight="220">
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
    </Grid>
</UserControl>
