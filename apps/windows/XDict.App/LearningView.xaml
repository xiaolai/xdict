<UserControl
    x:Class="XDict.App.LearningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource XDictSpaceXxl}" Spacing="{StaticResource XDictSpaceXxl}">
            <TextBlock x:Name="Heading" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                <TextBlock x:Name="RetentionLabel" FontSize="{StaticResource XDictTextBody}" />
                <TextBlock x:Name="RetentionDetail" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <ComboBox x:Name="Retention" MinWidth="{StaticResource XDictSizeButtonMinWidth}"
                          SelectionChanged="OnRetentionChanged"
                          AutomationProperties.AutomationId="SettingsReviewRetention" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                <ToggleSwitch x:Name="Reminders" Toggled="OnRemindersToggled"
                              AutomationProperties.AutomationId="SettingsReviewReminders" />
                <TextBlock x:Name="RemindersDetail" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="RemindersStatus" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsReviewRemindersStatus" />
                <Button x:Name="NotificationSettings" Click="OnNotificationSettings" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsNotificationSettings" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                <TextBlock x:Name="SyncLabel" FontSize="{StaticResource XDictTextBody}" />
                <TextBlock x:Name="SyncDetail" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="SyncFolderText" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsSyncFolder" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource XDictSpaceSm}">
                    <Button x:Name="ChooseSyncFolder" Click="OnChooseSyncFolder"
                            AutomationProperties.AutomationId="SettingsSyncChoose" />
                    <Button x:Name="SyncNow" Click="OnSyncNow"
                            AutomationProperties.AutomationId="SettingsSyncNow" />
                </StackPanel>
                <TextBlock x:Name="SyncStatus" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsSyncStatus" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                <TextBlock x:Name="ExportLabel" FontSize="{StaticResource XDictTextBody}" />
                <TextBlock x:Name="ExportDetail" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Button x:Name="ExportButton" Click="OnExport"
                        AutomationProperties.AutomationId="SettingsExportLearning" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                <TextBlock x:Name="EraseLabel" FontSize="{StaticResource XDictTextBody}" />
                <TextBlock x:Name="EraseDetail" FontSize="{StaticResource XDictTextCallout}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Button x:Name="EraseButton" Click="OnErase"
                        AutomationProperties.AutomationId="SettingsEraseLearning" />
            </StackPanel>
            <TextBlock x:Name="Status" FontSize="{StaticResource XDictTextCallout}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="SettingsLearningStatus" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
