<Window
    x:Class="XDict.App.ExploreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border Padding="{StaticResource XDictSpaceXxlThickness}">
            <Grid RowSpacing="{StaticResource XDictSpaceL}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="{StaticResource XDictTextHeadline}"
                           FontWeight="SemiBold" AutomationProperties.AutomationId="ExploreTitle" />
                <Grid Grid.Row="1" ColumnSpacing="{StaticResource XDictSpaceM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                        <TextBlock x:Name="ScopeLabel" FontSize="{StaticResource XDictTextCallout}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="Scope" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnScopeChanged"
                                  AutomationProperties.AutomationId="ExploreScope" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource XDictSpaceXs}">
                        <TextBlock x:Name="ModeLabel" FontSize="{StaticResource XDictTextCallout}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="Mode" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnModeChanged"
                                  AutomationProperties.AutomationId="ExploreMode" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="DistancePanel"
                                Spacing="{StaticResource XDictSpaceXs}" Visibility="Collapsed">
                        <TextBlock x:Name="DistanceLabel" FontSize="{StaticResource XDictTextCallout}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="Distance" Minimum="1" Maximum="3" Value="1"
                                   Width="{StaticResource XDictSizeButtonMinWidth}"
                                   AutomationProperties.AutomationId="ExploreDistance" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="{StaticResource XDictSpaceSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Query" KeyDown="OnQueryKeyDown"
                             AutomationProperties.AutomationId="ExploreQuery" />
                    <Button x:Name="RunButton" Grid.Column="1" Click="OnRun"
                            AutomationProperties.AutomationId="ExploreRun" />
                </Grid>
                <ListView Grid.Row="3" x:Name="Results" SelectionChanged="OnSelectionChanged"
                          AutomationProperties.AutomationId="ExploreResults" />
                <StackPanel Grid.Row="4" Spacing="{StaticResource XDictSpaceXs}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource XDictSpaceSm}">
                        <Button x:Name="PreviousButton" Click="OnPrevious"
                                AutomationProperties.AutomationId="ExplorePrevious" />
                        <Button x:Name="MoreButton" Click="OnMore"
                                AutomationProperties.AutomationId="ExploreMore" />
                        <Button x:Name="OpenButton" Click="OnOpen" IsEnabled="False"
                                AutomationProperties.AutomationId="ExploreOpen" />
                        <TextBlock x:Name="StatusText" FontSize="{StaticResource XDictTextCardMeta}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ExploreStatus" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
