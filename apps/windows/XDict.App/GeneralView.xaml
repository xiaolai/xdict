<UserControl
    x:Class="XDict.App.GeneralView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource XDictSpaceXxl}" Spacing="{StaticResource XDictSpaceL}">
            <TextBlock x:Name="Heading" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                <TextBlock x:Name="ThemeLabel" />
                <ComboBox x:Name="Theme" AutomationProperties.AutomationId="SettingsTheme"
                          SelectionChanged="OnThemeChanged" MinWidth="{StaticResource XDictSizeReviewWidth}" />
            </StackPanel>
            <ToggleSwitch x:Name="StartAtLogin" AutomationProperties.AutomationId="SettingsStartAtLogin"
                          Toggled="OnStartAtLoginToggled" />
            <TextBlock x:Name="Status" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
