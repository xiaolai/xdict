<Window
    x:Class="XDict.App.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border Padding="{StaticResource XDictSpaceXxlThickness}">
            <Grid RowSpacing="{StaticResource XDictSpaceL}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="{StaticResource XDictTextHeadline}"
                           FontWeight="SemiBold" AutomationProperties.AutomationId="HistoryTitle" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource XDictSpaceSm}">
                    <TextBlock x:Name="FilterLabel" FontSize="{StaticResource XDictTextCallout}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="Filter" MinWidth="{StaticResource XDictSizeReviewWidth}"
                              SelectionChanged="OnFilterChanged"
                              AutomationProperties.AutomationId="HistoryFilter" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DaysPanel" Spacing="{StaticResource XDictSpaceL}" />
                </ScrollViewer>
                <StackPanel Grid.Row="3" Spacing="{StaticResource XDictSpaceXs}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource XDictSpaceSm}">
                        <Button x:Name="RestoreButton" Click="OnRestore" Visibility="Collapsed"
                                AutomationProperties.AutomationId="HistoryRestore" />
                        <TextBlock x:Name="StatusText" FontSize="{StaticResource XDictTextCardMeta}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="HistoryStatus" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
