<UserControl
    x:Class="XDict.App.SpeechView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource XDictSpaceXxl}" Spacing="{StaticResource XDictSpaceL}">
            <TextBlock x:Name="Heading" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ToggleSwitch x:Name="UseRecordings" AutomationProperties.AutomationId="SettingsUseRecordings"
                          Toggled="OnRecordingsToggled" />
            <StackPanel Spacing="{StaticResource XDictSpaceXs}">
                <TextBlock x:Name="AccentLabel" />
                <ComboBox x:Name="Accent" AutomationProperties.AutomationId="SettingsAccent"
                          SelectionChanged="OnAccentChanged" MinWidth="{StaticResource XDictSizeReviewWidth}" />
            </StackPanel>
            <TextBlock x:Name="Status" AutomationProperties.AutomationId="SettingsSpeechStatus" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
