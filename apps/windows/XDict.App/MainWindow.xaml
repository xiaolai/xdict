<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XDict.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="GoBackAccel" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="GoForwardAccel" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearchAccel" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="12">
            <AutoSuggestBox x:Name="SearchBox" Width="360" QuerySubmitted="OnQuerySubmitted"
                            TextChanged="OnSearchTextChanged" SuggestionChosen="OnSuggestionChosen" />
            <ComboBox x:Name="ScopeBox" MinWidth="200" SelectionChanged="OnScopeChanged" />
            <Button x:Name="BackButton" Click="GoBack" />
            <Button x:Name="ForwardButton" Click="GoForward" />
            <Button x:Name="ReturnButton" Click="GoReturn" />
            <Button x:Name="LibraryButton" Click="OpenSettings" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="12,0,12,8" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="Results" SelectionChanged="OnResultSelected" KeyDown="OnResultsKeyDown" />
            <Grid x:Name="EntryHost" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
