<Window
    x:Class="XDict.App.MeaningWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border Padding="{StaticResource XDictSpaceXxlThickness}">
            <Grid RowSpacing="{StaticResource XDictSpaceL}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="{StaticResource XDictSpaceXs}">
                    <TextBlock x:Name="TitleText" FontSize="{StaticResource XDictTextHeadline}"
                               FontWeight="SemiBold" AutomationProperties.AutomationId="MeaningTitle" />
                    <TextBlock x:Name="TermText" FontSize="{StaticResource XDictTextCardWord}"
                               TextWrapping="Wrap" AutomationProperties.AutomationId="MeaningTerm" />
                    <TextBlock x:Name="MetaText" FontSize="{StaticResource XDictTextCardMeta}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="{StaticResource XDictSpaceXs}">
                    <TextBlock x:Name="SentenceLabel" FontSize="{StaticResource XDictTextCallout}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SentenceText" FontSize="{StaticResource XDictTextBody}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="MeaningSentence" />
                    <TextBlock x:Name="EntryUnavailable" FontSize="{StaticResource XDictTextCardMeta}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" AutomationProperties.AutomationId="MeaningEntryUnavailable" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="{StaticResource XDictSpaceSm}">
                    <TextBlock x:Name="ModeLabel" FontSize="{StaticResource XDictTextCallout}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="Mode" MinWidth="{StaticResource XDictSizeReviewWidth}"
                              SelectionChanged="OnModeChanged"
                              AutomationProperties.AutomationId="MeaningMode" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource XDictSpaceSm}">
                        <Button x:Name="AskButton" Click="OnAsk"
                                AutomationProperties.AutomationId="MeaningAsk" />
                        <Button x:Name="CancelButton" Click="OnCancel" IsEnabled="False"
                                AutomationProperties.AutomationId="MeaningCancel" />
                        <TextBlock x:Name="SourceText" FontSize="{StaticResource XDictTextCardMeta}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource XDictSpaceL}">
                        <StackPanel x:Name="PreviewPanel" Spacing="{StaticResource XDictSpaceXs}">
                            <TextBlock x:Name="PreviewLabel" FontSize="{StaticResource XDictTextCallout}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" AutomationProperties.AutomationId="MeaningPreview" />
                        </StackPanel>
                        <Border x:Name="AnswerPanel" Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="{StaticResource XDictRadiusLCorner}"
                                Padding="{StaticResource XDictSpaceLThickness}">
                            <StackPanel Spacing="{StaticResource XDictSpaceSm}">
                                <TextBlock x:Name="OutcomeText" FontSize="{StaticResource XDictTextBody}"
                                           FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="MeaningOutcome" />
                                <TextBlock x:Name="UngroundedText" FontSize="{StaticResource XDictTextCardMeta}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                                <TextBlock x:Name="ExplanationLabel" FontSize="{StaticResource XDictTextCallout}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ExplanationText" FontSize="{StaticResource XDictTextBody}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           AutomationProperties.AutomationId="MeaningExplanation" />
                                <TextBlock x:Name="QuotesLabel" FontSize="{StaticResource XDictTextCallout}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="QuotesPanel" Spacing="{StaticResource XDictSpaceXs}" />
                                <TextBlock x:Name="TranslationLabel" FontSize="{StaticResource XDictTextCallout}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TranslationText" FontSize="{StaticResource XDictTextBody}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           AutomationProperties.AutomationId="MeaningTranslation" />
                                <Button x:Name="SaveNoteButton" Click="OnSaveNote"
                                        AutomationProperties.AutomationId="MeaningSaveNote" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="4" x:Name="StatusText" FontSize="{StaticResource XDictTextCardMeta}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="MeaningStatus" />
            </Grid>
        </Border>
    </Grid>
</Window>
