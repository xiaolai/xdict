{
  "contract": 4,
  "status": "current at contract 4 (2026-11-05): entryText; tests/rust and tests/cs decode, validate and re-encode every fixture",
  "transport": {
    "pipe": "a private duplex pair created by the app at each spawn; the service's ends inherited through PROC_THREAD_ATTRIBUTE_HANDLE_LIST",
    "frame": [
      "u32 length (little-endian, payload bytes)",
      "u8 kind",
      "payload"
    ],
    "kinds": {
      "1": "json envelope",
      "2": "u64 transfer id, then bulk bytes"
    },
    "jsonMax": 4194304,
    "bulkMax": 67108864
  },
  "envelope": {
    "required": [
      "contract",
      "id",
      "op",
      "files",
      "operation"
    ],
    "contract": 4,
    "id": "u64, unique per connection, echoed",
    "files": {
      "id": "uuid, the app's file id",
      "name": "the name the core keys the source by",
      "handle": "u64, valid in the service process (DuplicateHandle with DUPLICATE_SAME_ACCESS)",
      "identity": {
        "device": "u64",
        "inode": "u64",
        "size": "u64",
        "mtimeNs": "i64",
        "ctimeNs": "i64"
      },
      "observedAt": "u64, monotonic; newest wins per file",
      "write": "bool, contract 3: the one writable ledgerSync destination; every other file is read-only"
    }
  },
  "reply": {
    "ok": {
      "contract": 4,
      "id": "echoed",
      "ok": "the operation's record"
    },
    "error": {
      "contract": 4,
      "id": "echoed",
      "error": {
        "type": "one of the typed errors",
        "detail": "logs only"
      }
    },
    "bulk": {
      "transfer": "u64",
      "length": "u64",
      "mime": "string; the kind-2 frame with this transfer id follows before any other reply"
    }
  },
  "operations": {
    "versions": {
      "operation": null,
      "ok": [
        "protocol",
        "core",
        "indexFormat",
        "normalization"
      ]
    },
