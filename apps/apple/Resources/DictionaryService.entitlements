<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The dictionary service: the sandbox, and the app group it shares with the app, nothing else. No file entitlement
     (a dictionary arrives as a descriptor the app opened) and no network: a dictionary file is untrusted input, and
     what parses it reaches nothing. The group holds only what the app staged there for conversion and what the service
     published from it (ADR-0011 decisions 4 and 9). The team prefix is Xcode's placeholder, expanded at signing from the
     signing identity (Tools/expand-entitlements.sh), so no team identifier is in the repository.
     BundleFactsTests and Tools/build-bundle.sh hold the signed service to exactly this. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)ai.xdict.app</string>
	</array>
</dict>
</plist>
