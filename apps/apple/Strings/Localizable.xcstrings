          "stringUnit": {
            "state": "translated",
            "value": "“%@”已变成链接或已离开所在文件夹，因此 XDict 不会读取它。"
          }
        }
      }
    },
    "“%@” is no longer a file XDict reads: a link, a folder or a pipe has taken its place.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is no longer a file XDict reads: a link, a folder or a pipe has taken its place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已不再是 XDict 能读取的文件：它的位置已被链接、文件夹或管道占据。"
          }
        }
      }
    },
    "“%@” is not a dictionary file (.mdx or .mdd).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a dictionary file (.mdx or .mdd)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是词典文件（.mdx 或 .mdd）。"
          }
        }
      }
    },
    "“%@” is not in this dictionary’s folder, but its entries use it %llu times, so they may look unstyled or not work. Put the file next to the .mdx to fix this.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is not in this dictionary’s folder, but its entries use it %2$#@n@, so they may look unstyled or not work. Put the file next to the .mdx to fix this."
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "llu",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "once"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg times"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”不在这部词典的文件夹里，但词条用到它 %2$llu 次，因此可能缺少样式或无法正常工作。把这个文件放到 .mdx 旁边即可解决。"
          }
        }
      }
    },
    "“%@” is not where it was, and XDict cannot find where it went.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not where it was, and XDict cannot find where it went."
