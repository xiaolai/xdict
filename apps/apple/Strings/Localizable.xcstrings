        }
      }
    },
    "%llu entries are stored twice under the same headword." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu entries are stored twice under the same headword."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu 个词条在同一词头下存了两遍。"
          }
        }
      }
    },
    "%llu entries hold bytes that are not text in the dictionary’s encoding." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu entries hold bytes that are not text in the dictionary’s encoding."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu 个词条含有按词典的编码无法读成文字的字节。"
          }
        }
      }
    },
    "%llu entries redirect to an entry that does not exist, or back to themselves." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu entries redirect to an entry that does not exist, or back to themselves."
