    },
    "XDict runs Claude Code in its own configuration, apart from the one in Terminal. To sign in there, run this in Terminal and follow the sign-in it shows:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XDict runs Claude Code in its own configuration, apart from the one in Terminal. To sign in there, run this in Terminal and follow the sign-in it shows:"
