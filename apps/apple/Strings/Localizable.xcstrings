          }
        }
      }
    },
    "%llu places show comment marks such as “-->” as text, or hide text in a broken comment. This is in the dictionary file itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu places show comment marks such as “-->” as text, or hide text in a broken comment. This is in the dictionary file itself."
