{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ Does Not Share Selections": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Does Not Share Selections"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不共享所选内容"
          }
        }
      }
    },
    "%@ did not answer when asked for its selection. Try again in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not answer when asked for its selection. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有回应对其选中内容的请求。请稍后再试。"
          }
        }
      }
    },
    "%@ has no ⌘, ⌃ or ⌥, so it would fire while you type. Choose another combination.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no ⌘, ⌃ or ⌥, so it would fire while you type. Choose another combination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不含 ⌘、⌃ 或 ⌥，打字时会被误触发。请换一个组合。"
          }
        }
      }
    },
    "%@ is a standard command other apps rely on. Choose another combination.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a standard command other apps rely on. Choose another combination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是其他 App 依赖的标准命令。请换一个组合。"
          }
        }
      }
    },
    "%@ is already excluded.": {
      "comment": "The placeholder is a site's host, such as 'example.com'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被排除。"
          }
        }
      }
    },
    "%@ is unavailable. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is unavailable. %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不可用。%2$@"
          }
        }
      }
    },
    "%@ is unavailable. %@ Still using %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is unavailable. %2$@ Still using %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不可用。%2$@仍在使用 %3$@。"
          }
        }
      }
    },
    "%@ is unavailable. %@ The previous shortcut could not be put back either, so no shortcut is set.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is unavailable. %2$@ The previous shortcut could not be put back either, so no shortcut is set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不可用。%2$@原来的快捷键也无法恢复，因此目前没有设置快捷键。"
          }
        }
      }
    },
    "%@ quit before its selection could be read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quit before its selection could be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在读取其选中内容之前已退出。"
          }
        }
      }
    },
    "%@ refused to share its selection. If the screen is locked, unlock it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refused to share its selection. If the screen is locked, unlock it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝共享其选中内容。如果屏幕已锁定，请解锁后再试。"
          }
        }
      }
    },
    "%@ was not added: it is locked to its buyer with a registration code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was not added: it is locked to its buyer with a registration code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未添加：它用注册码锁定给了购买者。"
          }
        }
      }
    },
    "%@ works now but could not be saved, so it will not survive a restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ works now but could not be saved, so it will not survive a restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在可用，但未能保存，重新启动后将失效。"
          }
        }
      }
    },
    "%@'s window is too large to search for a selection (over %lld elements). Select the word again and try once more.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s window is too large to search for a selection (over %2$#@n@). Select the word again and try once more."
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg element"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg elements"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的窗口太大，无法从中查找选中内容（超过 %2$lld 个元素）。请重新选中该词再试一次。"
          }
        }
      }
    },
    "%@, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@"
          }
        }
      }
    },
    "%@, %@, %@, in %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, in %4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@，%3$@，出自%4$@"
          }
        }
      }
    },
    "%@, %@, in %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, in %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@，出自%3$@"
          }
        }
      }
    },
    "%@, edition %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, edition %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，版本标识 %2$@"
          }
        }
      }
    },
    "%@, edition %@, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, edition %2$@, %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，版本标识 %2$@，%3$@"
          }
        }
      }
    },
    "%lld Apple dictionaries are in use in Dictionary.app.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Apple dictionary is in use in Dictionary.app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Apple dictionaries are in use in Dictionary.app."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 部 Apple 词典已在“词典”App 中启用。"
          }
        }
      }
    },
    "%lld dictionaries couldn’t be searched": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dictionary couldn’t be searched"
                }
