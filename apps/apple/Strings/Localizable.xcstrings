    "“%@” is not in this dictionary’s folder, but its entries use it %llu times, so they may look unstyled or not work. Put the file next to the .mdx to fix this." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is not in this dictionary’s folder, but its entries use it %2$#@n@, so they may look unstyled or not work. Put the file next to the .mdx to fix this."
          },
          "substitutions" : {
            "n" : {
              "argNum" : 2,
              "formatSpecifier" : "llu",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "once"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg times"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”不在这部词典的文件夹里，但词条用到它 %2$llu 次，因此可能缺少样式或无法正常工作。把这个文件放到 .mdx 旁边即可解决。"
          }
        }
      }
    },
