    "Automatic": {
      "comment": "Read text with: the text an app shares first, the screen where it shares none",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Automatic reads the text an app shares, and the screen where it shares none. Screen Only always reads the screen, and needs Screen Recording; while any site is in Never look up on, it reads nothing in web browsers, and reads a web page shown inside another app as that app's screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic reads the text an app shares, and the screen where it shares none. Screen Only always reads the screen, and needs Screen Recording; while any site is in Never look up on, it reads nothing in web browsers, and reads a web page shown inside another app as that app's screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”读取应用提供的文字，应用不提供时读取屏幕。“仅屏幕”始终读取屏幕，需要“屏幕录制”权限；只要“从不在这些网站上查询”中列有任何网站，就不读取网页浏览器中的内容；其他应用中内嵌的网页则按该应用的屏幕内容读取。"
          }
        }
      }
    },
