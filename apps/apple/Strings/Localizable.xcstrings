        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 部词典未能查询"
          }
        }
      }
    },
    "%lld files beside the dictionary were left out: one dictionary takes at most 64 files.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file beside the dictionary was left out: one dictionary takes at most 64 files."
                }
              },
              "other": {
