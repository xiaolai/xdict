          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查词时的上下文句子保存在这台 Mac 上，并会与笔记和评分一起复制到同步文件夹，供其他设备使用。向 AI 提问另行控制，请参阅“设置”▸“AI”。"
          }
