        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@n@ larger than %2$@ and may be slow to show."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "llu",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg entry is"
                    }
                  },
                  "other": {
