    },
    "The selection in %@ is %lld characters long, more than XDict looks up at once. Select a word or a phrase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection in %1$@ is %2$#@n@ long, more than XDict looks up at once. Select a word or a phrase."
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg character"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg characters"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中的选中内容长 %2$lld 个字符，超过了 XDict 一次能查询的长度。请选中一个词或短语。"
          }
        }
      }
    },
    "The selection in %@ is too long to read at once. Select a word or a phrase.": {
