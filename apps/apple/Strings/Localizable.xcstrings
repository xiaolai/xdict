            "state": "translated",
            "value": "无法读取“%@”。"
          }
        }
      }
    },
    "“%@” has become a link or has left its folder, so XDict will not read it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has become a link or has left its folder, so XDict will not read it."
          }
