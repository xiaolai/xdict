        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu 处把“-->”之类的注释符号显示成了文字，或把文字藏进了残缺的注释。问题出在词典文件本身。"
          }
        }
      }
    },
    "%llu places show garbled characters: their text was encoded twice when the dictionary was made." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu places show garbled characters: their text was encoded twice when the dictionary was made."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu 处显示为乱码：制作词典时这些文字被编码了两次。"
          }
        }
      }
    },
