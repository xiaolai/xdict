    "“%@” could not be added: it was moved or deleted, or XDict does not have permission to read it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” could not be added: it was moved or deleted, or XDict does not have permission to read it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未能添加：它已被移动或删除，或 XDict 没有读取它的权限。"
          }
        }
      }
    },
    "“%@” could not be opened. Check that you may read it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” could not be opened. Check that you may read it."
