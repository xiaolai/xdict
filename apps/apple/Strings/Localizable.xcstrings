          }
        }
      }
    },
    "%llu headwords hold extra spaces, invisible characters or HTML code." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu headwords hold extra spaces, invisible characters or HTML code."
