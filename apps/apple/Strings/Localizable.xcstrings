          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "XDict 读取你已有的 MDict 词典：.mdx 文件及其 .mdd 资源。请添加文件或文件夹，或将它们拖放到这里。"
          }
