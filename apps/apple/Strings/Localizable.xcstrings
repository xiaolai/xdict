        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu 个词条跳转到不存在的词条，或跳回自身。"
          }
        }
      }
    },
    "%llu entries show style rules as text. This is in the dictionary file itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%llu entries show style rules as text. This is in the dictionary file itself."
