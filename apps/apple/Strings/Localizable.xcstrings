          }
        }
      }
    },
    "Notice when the sentence you capture holds a phrase your dictionaries know, and keep it as a card. Off, the sentence is not sent to XDict’s dictionary service for matching.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice when the sentence you capture holds a phrase your dictionaries know, and keep it as a card. Off, the sentence is not sent to XDict’s dictionary service for matching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读时，发现你截取的句子里含有词典收录的词组，并可以把它保存为卡片。关闭后，句子不会发送给 XDict 的词典服务做匹配。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Off": {
