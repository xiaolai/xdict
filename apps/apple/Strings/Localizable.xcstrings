    "The prompt must include {%@}.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt must include {%@}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示词必须包含 {%@}。"
          }
        }
      }
    },
    "The prompt needs {term} and {sentence}; {language} is optional, and {entry} and {sense} are not used here. A missing or unknown placeholder is refused before anything is sent. XDict appends the response format, which cannot be edited.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt needs {term} and {sentence}; {language} is optional, and {entry} and {sense} are not used here. A missing or unknown placeholder is refused before anything is sent. XDict appends the response format, which cannot be edited."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示词需要 {term} 和 {sentence}；{language} 可选，此处不使用 {entry} 和 {sense}。缺少或未知的占位符会在发送前被拒绝。XDict 会追加回复格式，该格式不可编辑。"
          }
        }
      }
    },
    "The prompt needs {term} and {sentence}; {language} is optional, and {entry} and {sense} are not used. A missing or unknown placeholder is refused before anything is sent. XDict appends the response format, which cannot be edited.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt needs {term} and {sentence}; {language} is optional, and {entry} and {sense} are not used. A missing or unknown placeholder is refused before anything is sent. XDict appends the response format, which cannot be edited."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示词需要 {term} 和 {sentence}；{language} 可选；这里不用 {entry} 和 {sense}。缺少或未知的占位符会在发送前被拒绝。XDict 会附加回答格式，格式不可编辑。"
          }
        }
      }
    },
    "The prompt needs {term} and {sentence}; {language} names the language to translate into and is optional here, and {entry} and {sense} are not used. A missing or unknown placeholder is refused before anything is sent. XDict appends the response format, which cannot be edited.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt needs {term} and {sentence}; {language} names the language to translate into and is optional here, and {entry} and {sense} are not used. A missing or unknown placeholder is refused before anything is sent. XDict appends the response format, which cannot be edited."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示词需要 {term} 和 {sentence}；{language} 指翻译成的语言，在这里可选；这里不用 {entry} 和 {sense}。缺少或未知的占位符会在发送前被拒绝。XDict 会附加回答格式，格式不可编辑。"
          }
        }
      }
    },
    "The prompt needs {term}, {sentence} and {entry}; {language} is optional and {sense} is not used here. A missing or unknown placeholder is refused before anything is sent. XDict appends the response format, which cannot be edited.": {
      "localizations": {
        "en": {
          "stringUnit": {
