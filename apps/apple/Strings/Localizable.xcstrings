    "Entries are not shown: XDict cannot confirm that the WebKit switch “%@” is off." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entries are not shown: XDict cannot confirm that the WebKit switch “%@” is off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词条未显示：XDict 无法确认 WebKit 开关“%@”已关闭。"
          }
        }
      }
    },
    "Entries are not shown: XDict could not set up the rules that keep them off the internet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entries are not shown: XDict could not set up the rules that keep them off the internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词条未显示：XDict 无法设置让词条不连接互联网的规则。"
          }
        }
      }
    },
    "Entries are not shown: the WebKit switch “%@” stayed on after XDict turned it off." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entries are not shown: the WebKit switch “%@” stayed on after XDict turned it off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词条未显示：XDict 关闭 WebKit 开关“%@”后，它仍处于开启状态。"
          }
        }
      }
    },
    "Entries are not shown: this version of macOS lacks the WebKit switch “%@” that keeps them off the internet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entries are not shown: this version of macOS lacks the WebKit switch “%@” that keeps them off the internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词条未显示：此版本的 macOS 缺少让词条不连接互联网的 WebKit 开关“%@”。"
          }
        }
      }
    },
    "Entries are shown confined: nothing in them reaches the internet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entries are shown confined: nothing in them reaches the internet."
